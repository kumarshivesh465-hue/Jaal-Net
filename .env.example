[TEMPLATE]
# Copy to .env and fill in. Never commit .env.

# Exasol SaaS Cloud or Local Connection
EXASOL_DSN=your-cluster-id.clusters.exasol.com:8563
EXASOL_USER=your-username
EXASOL_PASSWORD=your-personal-access-token
EXASOL_SCHEMA=FRAUD

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
